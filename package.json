{
  "name": "avy-tab-switcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "package": "pnpm run package:chrome && pnpm run package:firefox",
    "package:chrome": "wxt zip",
    "package:firefox": "wxt zip -b firefox",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run tests",
    "coverage": "vitest run --coverage tests",
    "e2e": "pnpm run build:chrome && playwright test",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run coverage && pnpm run build"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
