    "@vue/test-utils": "^2.5.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "happy-dom": "^20.14.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
